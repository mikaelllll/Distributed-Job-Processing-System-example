# Local-development template only. Replace every "change-me" value before use.
# Never commit a populated .env file.
POSTGRES_DB=job_platform
POSTGRES_USER=job_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://job_platform:change-me@postgres:5432/job_platform
RABBITMQ_USER=job_platform
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://job_platform:change-me@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_MAX_JOBS=1000000
METRICS_FLUSH_INTERVAL_SECONDS=2
